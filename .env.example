# Copy these keys to .env.dev and replace the placeholder values locally.
# Never put real credentials in this example file.

MYSQL_DATABASE=shopping_dev
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-password
MYSQL_USER=shopping_dev_app
MYSQL_PASSWORD=replace-with-local-application-database-password
SPRING_PROFILES_ACTIVE=dev

# These values only apply when running Spring directly on the host. The dev
# Compose command derives its datasource values from MYSQL_DATABASE/USER/PASSWORD.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shopping_dev
SPRING_DATASOURCE_USERNAME=shopping_dev_app
SPRING_DATASOURCE_PASSWORD=replace-with-local-application-database-password

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# JWT signing secret. Must be at least 32 bytes (256 bits) of random data.
# Generate one locally, e.g. `openssl rand -base64 48`, and never reuse across environments.
JWT_SECRET=replace-with-local-jwt-secret-at-least-32-bytes-long

# JWT issuer and audience must differ between environments so a token minted
# for one deployment cannot be replayed against another.
JWT_ISSUER=shopping-dev
JWT_AUDIENCE=shopping-dev-api

# CORS allowed origins for the API, comma-separated. Default (in
# application.properties) permits the local frontend dev server; set this to
# the deployed frontend origin(s) in staging / production, e.g.
# APP_CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
