# Copy to /Users/yklin/services/shopping-website/staging/staging.env on the Mac mini.
# Replace every placeholder locally. Never commit that copied file.
MYSQL_DATABASE=shopping_staging
MYSQL_ROOT_PASSWORD=replace-with-staging-mysql-root-password
MYSQL_USER=shopping_staging_app
MYSQL_PASSWORD=replace-with-staging-application-database-password

SPRING_IMAGE=ghcr.io/albertkingdom/spring-boot-shopping-website-spring@sha256:replace-with-verified-digest
FRONTEND_IMAGE=ghcr.io/albertkingdom/spring-boot-shopping-website-frontend@sha256:replace-with-verified-digest

# Temporarily shared with the existing Cloudinary account. The staging profile
# fixes uploads to shopping-website/staging; never put these values in Git.
CLOUDINARY_CLOUD_NAME=replace-with-existing-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-existing-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-existing-cloudinary-api-secret
JWT_SECRET=replace-with-staging-jwt-secret-at-least-32-bytes-long
JWT_ISSUER=shopping-staging
JWT_AUDIENCE=shopping-staging-api
APP_CORS_ALLOWED_ORIGINS=https://staging-shop.albertkingdom.com
SPRING_PROFILES_ACTIVE=staging
STAGING_FRONTEND_PORT=8081
