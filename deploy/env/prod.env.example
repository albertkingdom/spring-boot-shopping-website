# Copy to /Users/yklin/services/shopping-website/prod/prod.env on the Mac mini.
# Replace every placeholder locally. Never commit that copied file.
MYSQL_DATABASE=shopping_prod
MYSQL_ROOT_PASSWORD=replace-with-production-mysql-root-password
MYSQL_USER=shopping_prod_app
MYSQL_PASSWORD=replace-with-production-application-database-password

SPRING_IMAGE=ghcr.io/albertkingdom/spring-boot-shopping-website-spring@sha256:replace-with-verified-digest
FRONTEND_IMAGE=ghcr.io/albertkingdom/spring-boot-shopping-website-frontend@sha256:replace-with-verified-digest

# Temporarily shared with the existing Cloudinary account. The production profile
# fixes uploads to shopping-website/prod; never put these values in Git.
CLOUDINARY_CLOUD_NAME=replace-with-existing-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-existing-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-existing-cloudinary-api-secret
JWT_SECRET=replace-with-production-jwt-secret-at-least-32-bytes-long
JWT_ISSUER=shopping-prod
JWT_AUDIENCE=shopping-prod-api
APP_CORS_ALLOWED_ORIGINS=https://shop.albertkingdom.com
SPRING_PROFILES_ACTIVE=prod
PROD_FRONTEND_PORT=8082
